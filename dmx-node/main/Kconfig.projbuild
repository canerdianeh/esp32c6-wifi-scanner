menu "DMX Node"

    comment "Board wiring. Show settings (modes, universes) are set at runtime over the web page or Bluetooth."
    comment "Pin defaults: ESP32-S3-DevKitC-1, ESP32-C6-DevKitC-1, ESP32-DevKitC (WROOM)."

    config NODE_NAME
        string "Node name prefix"
        default "DMX-Node"
        help
            Used for the setup access point, the Bluetooth name and the
            Art-Net short name, followed by the last 4 hex digits of the MAC,
            e.g. DMX-Node-8641. It can be renamed at runtime.

    config NODE_AP_PASSWORD
        string "Setup access point password (8-63 characters)"
        default "dmxsetup"
        help
            The node starts this access point when it has no Wi-Fi network
            configured, or can't join the one it has. The setup page is at
            http://192.168.4.1/.

    menu "Port A (DMX in or out)"

        config NODE_PORT_A_UART
            int "UART number"
            range 0 2
            default 1

        config NODE_PORT_A_TX_GPIO
            int "TX GPIO (to the RS485 transceiver's DI)"
            range 0 48
            default 0 if IDF_TARGET_ESP32C6
            default 17

        config NODE_PORT_A_RX_GPIO
            int "RX GPIO (from the RS485 transceiver's RO)"
            range 0 48
            default 1 if IDF_TARGET_ESP32C6
            default 16 if IDF_TARGET_ESP32
            default 18

        config NODE_PORT_A_DIR_GPIO
            int "Direction GPIO (to DE and /RE, high = transmit), -1 if none"
            range -1 48
            default 2 if IDF_TARGET_ESP32C6
            default 4 if IDF_TARGET_ESP32
            default 8
    endmenu

    menu "Port B (DMX out)"

        config NODE_PORT_B_UART
            int "UART number"
            range 0 2
            default 0 if IDF_TARGET_ESP32C6
            default 2
            help
                The ESP32-C6 has only UART0 and UART1, so port B uses UART0
                there (the log goes to the USB port instead).

        config NODE_PORT_B_TX_GPIO
            int "TX GPIO (to the RS485 transceiver's DI)"
            range 0 48
            default 3 if IDF_TARGET_ESP32C6
            default 25 if IDF_TARGET_ESP32
            default 15

        config NODE_PORT_B_DIR_GPIO
            int "Direction GPIO (to DE and /RE, high = transmit), -1 if none"
            range -1 48
            default 10 if IDF_TARGET_ESP32C6
            default 26 if IDF_TARGET_ESP32
            default 16
    endmenu

    menu "Pixel output (SPI)"

        config NODE_PIXEL_DATA_GPIO
            int "Data GPIO"
            range 0 48
            default 7 if IDF_TARGET_ESP32C6
            default 23 if IDF_TARGET_ESP32
            default 11

        config NODE_PIXEL_CLOCK_GPIO
            int "Clock GPIO (APA102 / SK9822 only), -1 if none"
            range -1 48
            default 6 if IDF_TARGET_ESP32C6
            default 18 if IDF_TARGET_ESP32
            default 12

        config NODE_PIXEL_MAX
            int "Maximum pixels"
            range 1 680
            default 680
            help
                680 RGB (or 512 RGBW) pixels fill four universes, the most
                one strip can use.
    endmenu

    menu "PWM output (LEDs or servos)"

        config NODE_PWM_GPIOS
            string "GPIOs, comma separated (up to 8)"
            default "18,19,20,21,22,23" if IDF_TARGET_ESP32C6
            default "32,33,27,14,13,21,22,19" if IDF_TARGET_ESP32
            default "4,5,6,7,1,2,42,41"
            help
                Channel 1 is the first GPIO. The ESP32-C6 has 6 PWM channels,
                so only the first 6 GPIOs are used there.

        config NODE_PWM_LED_FREQ_HZ
            int "LED PWM frequency (Hz)"
            range 100 40000
            default 19500
            help
                At 19.5 kHz the PWM has 12-bit resolution, which is above
                hearing range and shows no flicker on camera.
    endmenu

    config NODE_BLE_SETUP
        bool "Bluetooth LE setup"
        default y
        help
            A GATT service to read and change the settings from a phone.
            See README.md for the UUIDs and format.

    config NODE_BLE_SETUP_MINUTES
        int "Turn Bluetooth off after (minutes, 0 = never)"
        depends on NODE_BLE_SETUP
        range 0 1440
        default 5
        help
            While Bluetooth is on, Wi-Fi must share the radio and can't turn
            off power saving, which adds latency and dropped multicast
            frames. After this time (if nobody is connected) Bluetooth shuts
            down and Wi-Fi runs at full speed. Bluetooth stays on while no
            Wi-Fi network is configured.

endmenu
