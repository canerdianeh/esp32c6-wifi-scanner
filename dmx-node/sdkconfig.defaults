# Common to all targets. Target-specific settings are in sdkconfig.defaults.<target>.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The log goes to the USB port so both UARTs are free for DMX.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth LE (NimBLE, peripheral only) for setup.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Lighting data is latency sensitive: bigger UDP receive mailbox, more
# multicast groups (one per sACN universe), and a faster FreeRTOS tick.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_IGMP=y
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_FREERTOS_HZ=1000

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
