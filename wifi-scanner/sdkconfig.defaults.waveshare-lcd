# Waveshare ESP32-C6-LCD-1.47 (ST7789 172x320, ESP32-C6FH8 with 8 MB flash, WS2812 status LED on GPIO8)
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8mb.csv"
CONFIG_SCANNER_DISPLAY=y
CONFIG_SCANNER_ONBOARD_LED_ORDER_RGB=y
CONFIG_SCANNER_SD_LOG=y
CONFIG_SCANNER_GPS=y
# Console on the USB-C port (USB-Serial-JTAG), which also carries SD log downloads
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Bluetooth LE: NimBLE. Observer for the BLE scanner; peripheral + broadcaster for phone GPS
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Zigbee / 802.15.4 scanner
CONFIG_IEEE802154_ENABLED=y
# Wi-Fi FTM (802.11mc) ranging as initiator, for distances in Wi-Fi details
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=y
